        {
            "name": "linux-x64-clang-libstdcpp-static-debug-install",
            "displayName": "Linux Clang with GNU C++ Lib x64. Static Debug Install",
            "description": "Linux Clang with GNU C++ Lib x64. Static Debug Install",
            "inherits": [
