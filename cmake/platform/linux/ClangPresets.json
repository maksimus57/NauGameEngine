        },
        {
            "name": "linux-x64-clang-libstdcpp-static-release-install",
            "displayName": "Linux Clang with GNU C++ Lib x64. Static Release Install",
            "description": "Linux Clang with GNU C++ Lib x64. Static Release Install",
